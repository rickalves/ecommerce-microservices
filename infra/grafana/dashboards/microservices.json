{
  "id": null,
  "uid": "ecommerce-microservices",
  "title": "Ecommerce Microservices",
  "tags": ["ecommerce", "nodejs", "nestjs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, service)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "description": "Requisições HTTP por segundo por serviço",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error Rate (4xx + 5xx)",
      "description": "Requisições com erros por segundo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "color": { "fixedColor": "red", "mode": "fixed" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\", status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência P95 (segundos)",
      "description": "Percentil 95 da latência HTTP",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p95 {{service}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p99 {{service}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Eventos RabbitMQ",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Eventos Consumidos (eventos/s)",
      "description": "Taxa de consumo de eventos do RabbitMQ",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service, event_type) (rate(event_consumed_total{service=~\"$service\", status=\"success\"}[5m]))",
          "legendFormat": "{{service}} / {{event_type}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Eventos com Erro (eventos/s)",
      "description": "Taxa de eventos consumidos com erro",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0, "color": { "fixedColor": "orange", "mode": "fixed" } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service, event_type) (rate(event_consumed_total{service=~\"$service\", status=\"error\"}[5m]))",
          "legendFormat": "{{service}} / {{event_type}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Duração Processamento Eventos P95",
      "description": "Percentil 95 da duração de processamento de eventos",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, event_type, le) (rate(event_processing_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "p95 {{service}} / {{event_type}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Negócio",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Pedidos Criados (pedidos/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(orders_created_total{service=\"order-service\"}[5m])",
          "legendFormat": "pedidos criados/s"
        },
        {
          "expr": "rate(orders_failed_total{service=\"order-service\"}[5m])",
          "legendFormat": "pedidos com falha/s"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Pagamentos Processados (pagamentos/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(payments_processed_total{service=\"payment-service\", status=\"completed\"}[5m])",
          "legendFormat": "completados/s"
        },
        {
          "expr": "rate(payments_processed_total{service=\"payment-service\", status=\"failed\"}[5m])",
          "legendFormat": "falhos/s"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Totais Acumulados",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "orders_created_total{service=\"order-service\"}",
          "legendFormat": "Pedidos Criados"
        },
        {
          "expr": "payments_processed_total{service=\"payment-service\", status=\"completed\"}",
          "legendFormat": "Pagamentos OK"
        },
        {
          "expr": "payments_processed_total{service=\"payment-service\", status=\"failed\"}",
          "legendFormat": "Pagamentos Falhos"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Runtime Node.js",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Heap Usado (bytes)",
      "description": "Memória heap do Node.js em uso por serviço",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Event Loop Lag (segundos)",
      "description": "Atraso do event loop do Node.js — valores altos indicam CPU bloqueada",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds{service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "CPU Process (segundos/s)",
      "description": "Uso de CPU dos processos Node.js",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{service=~\"$service\"}[5m])",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
